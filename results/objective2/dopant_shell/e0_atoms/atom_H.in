&CONTROL
   calculation      = 'scf'
   outdir           = './tmp'
   prefix           = 'atom_H'
   disk_io          = 'none'
   pseudo_dir       = '/data/pseudo'
/
&SYSTEM
   tot_magnetization = 1
   ecutwfc          = 50.0
   ecutrho          = 400.0
   nosym            = .true.
   occupations      = 'smearing'
   degauss          = 0.002
   smearing         = 'gaussian'
   nspin            = 2
   starting_magnetization(1) = 0.5
   ntyp             = 1
   nat              = 1
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 400
   conv_thr         = 1e-08
   mixing_beta      = 0.2
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
H  1.008 H.pbe-rrkjus_psl.1.0.0.UPF

K_POINTS gamma

CELL_PARAMETERS angstrom
16.00000000000000 0.00000000000000 0.00000000000000
0.00000000000000 16.32000000000000 0.00000000000000
0.00000000000000 0.00000000000000 16.64000000000000

ATOMIC_POSITIONS angstrom
H  8.1100000000 8.0700000000 8.0300000000  

