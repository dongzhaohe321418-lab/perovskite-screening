+T11_DRIVER = r'''"""Written by e_selftest.py case T11: a synthetic c3b stage -> the private archive, by the runner's code."""
+import hashlib, importlib.util, json, os, sys
+
+plan = json.load(open(sys.argv[1]))
+s = importlib.util.spec_from_file_location("t11_s50", os.path.join(plan["scripts"], "50_s2_campaign.py"))
+s50 = importlib.util.module_from_spec(s)
+s.loader.exec_module(s50)
+c46, q47, g49 = s50.c46, s50.q47, s50.g49
+assert not s50.MOCKED, s50.MOCKED
+stage = plan["stage"]
+cw, jobs = os.path.join(stage, "work", "c3b"), os.path.join(stage, "jobs", "s2c3b")
+state = s50.synthetic_state(**plan["state_over"])
+tab = s50.c3b_site_table(state)                       # the runner's site table (scripts/46 site_sets on the pool)
+g49.c3b_sites_check(tab, state)
+quartets = g49.c3b_quartets(tab)
+wids = sorted({w for q in quartets for w in q["wids"].values()})
+labels = list(g49.c3b_table_labels(tab))
+assert wids == plan["wids"] and labels == plan["labels"], "T11's cells are not the runner's production graph"
+for f in plan["records"]:
+    c46.dump_public(c46.cell_record(**f), os.path.join(cw, "cells", f["work_id"], "record.json"))
+
+
+def gate(name, gid, res, dec):
+    """gates/<name>.json, gates_applied/<id>.gate.json, the marker and the inputs file (scripts/50 run_gate)."""
+    g = {"schema": "s2-gate-1", "gate": name, "campaign": "c3b", "commit": plan["commit"], "attempt": 1, "opened": [],
+         "inputs_digest": hashlib.sha256(gid.encode()).hexdigest(), "result": res, "decision": dec,
+         "written": plan["ts"]}
+    stem = "".join(ch if ch.isalnum() or ch in "_.-" else "_" for ch in gid)
+    c46.dump_public(g, os.path.join(cw, "gates", f"{name}.json"))
+    c46.dump_public(g, os.path.join(cw, "gates_applied", f"{stem}.gate.json"))
+    c46.dump_public({"schema": "s2-gate-applied-1", "id": gid, "gate": name, "rc": 0, "attempt": 1, "decision": dec,
+                     "gate_file_sha256": s50.sha256_file(os.path.join(cw, "gates", f"{name}.json")),
+                     "applied": plan["ts"]}, os.path.join(cw, "gates_applied", f"{stem}.json"))
+    c46.dump_public({"synthetic": True}, os.path.join(cw, "gates_applied", f"{stem}.inputs.json"))
+
+
+class Reader:
+    """The two reads of gate c3b_tier (scripts/49 Reader.sp_state and Reader.record) on the node layout."""
+
+    def sp_state(self, label):
+        return q47.sp_status(os.path.join(jobs, label), label)
+
+    def record(self, wid):
+        p = os.path.join(cw, "cells", wid, "record.json")
