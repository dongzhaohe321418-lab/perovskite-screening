+def t11_assert_p15(R, ind, A, where):
+    """The P section 15 items of block 4 that every route prints, against the independent recomputation: raw E_b
+    and e_h(j) of every quartet, Y_h and Delta_h, E_d(j), G_d, n_d, and the zero-shot MACE E_b of the records."""
+    P = A.plan
+    for d in T_DOPANTS:
+        q, L = ind["per"][d], T_SUB[d]
+        assert R["B4.nd"].values["n_d"][d] == q["n"] == R[f"B4.tier.{d}"].values["n_d"], (where, d)
+        for h in T11_HOSTS:
+            y = R[f"B4.Y.{h}.{d}"].values
+            assert y["valid"] == (h in q["Y"]) and (not y["valid"] or (
+                _t_close(y["Y_h_meV"], q["Y"][h]) and _t_close(y["Delta_h_meV"], q["Delta"][h]))), (where, h, d)
+            for j in T_FIRST[L] + _t11_far(h, L):
+                x = R[f"B4.Eb.{h}.{d}{j}"]
+                assert _t_close(x.values["Eb_meV"], q["raw"][h][j]) and x.values["valid"] == (
+                    q["raw"][h][j] is not None), (where, x.id, x.values, q["raw"][h][j])
+                if j in T_FIRST[L]:
+                    # e_h(j) = E_b,h(j) - mean_f E_b,h(f) from the planted energies, wherever the quartet and both far
+                    # quartets are valid: the definition ind_tier uses (ind_tier and e_block4 cite P:143-146 for it;
+                    # the plan itself was not read for T11). E prints the value also at a host that is not a valid
+                    # host for d (too few first-shell quartets); by reading e_block4._compose it enters no pooled
+                    # statistic. Whether the plan wants it printed there is not ruled: this oracle follows what E
+                    # prints (see case_t11, C3B-NOTIER)
+                    far = [q["raw"][h][f] for f in _t11_far(h, L)]
+                    want = None if q["raw"][h][j] is None or any(v is None for v in far) else \
+                        q["raw"][h][j] - (far[0] + far[1]) / 2.0
+                    assert _t_close(x.values["e_meV"], want), \
+                        (where, x.id, x.values["e_meV"], want, x.line[:150], R[f"B4.Y.{h}.{d}"].text[:150])
+                    if h in q["Y"]:
+                        assert _t_close(x.values["e_meV"], q["e"][h].get(j)), (where, x.id)
+                if x.values["Eb_meV"] is not None:
+                    assert f"E_b^A1 = {'%.2f' % q['raw'][h][j]} meV" in x.line, (where, x.line[:160])
+                labs = (f"s2_{h}_{d}{j}o0_vac", f"s2_{h}_{d}{j}o0_novac", f"s2_{h}_V{L}{j}", f"s2_{h}_host")
+                m = R[f"B4.mace.{h}.{d}{j}"].values["Eb_mace_meV"]
+                if all(x_ in P.mace for x_ in labs):
+                    v = [Fraction(P.mace[x_]) for x_ in labs]
+                    assert _t_close(m, float(((v[0] - v[1]) - (v[2] - v[3])) * 1000)), (where, h, d, j, m)
+                else:
+                    assert m is None, (where, h, d, j, m)
+        for j in T_FIRST[L]:
+            assert _t_close(R[f"B4.site.{d}.{j}"].values["Ebar_meV"], q["Ebar"].get(j)), (where, d, j)
+        assert _t_close(R[f"B4.G.{d}"].values["G_meV"], q["G"]), (where, d)
+
