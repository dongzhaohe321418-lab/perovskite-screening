+def _t11_stop_reached(h, i, kind):
+    """A campaign stopped in its fourth host: three hosts complete; the fourth with every record, 30 single
+    points (in the order of _t11_cells: the host, the 19 V+ cells, the 8 Sr cells and 2 Cl cells, so that this host
+    is a valid host for Sr alone: n_d = 4 for Sr and 3 for Cl, Cs and GA), 5 inputs staged; of the fifth the host
+    record and its staged input only."""
+    k = T11_HOSTS.index(h)
+    if k < 3:
+        return "all"
+    if k == 3:
+        return "all" if i < 30 else "in" if i < 35 else "record"
+    return "in" if k == 4 and kind == "host" else None
