+def t11_expect_private(A):
+    """The files of the private root that block 4 opens, from the plan: campaign.json, MANIFEST.sha256 and (c3b
+    done) state_end.json at admission; every record; every single-point output (the attempts of a .gaveup cell
+    included); every p0 pair file. -> (relative paths of block 4, those of admission)."""
+    P, b4_files, adm = A.plan, set(), {"c3b/campaign.json", "c3b/MANIFEST.sha256"}
+    if P.status == "done":
+        adm.add("c3b/state_end.json")
+    for h in T11_HOSTS:
+        for wid, kind, lab, L, j, tok, leg in P.cells[h]:
+            if wid in P.records:
+                b4_files.add(f"c3b/records/{wid}.json")
+            if lab in P.complete:
+                b4_files.add(f"c3b/raw/{lab}.out.gz")
+        for tok in T_DOPANTS:
+            for j in T_FIRST[T_SUB[tok]] + _t11_far(h, T_SUB[tok]):
+                if (h, f"{tok}{j}") in P.rejected or f"s2_{h}_{tok}{j}p0_novac" in P.records:
+                    b4_files.add(f"c3b/pairs/{h}_{tok}{j}p0.json")
+    return b4_files, adm
