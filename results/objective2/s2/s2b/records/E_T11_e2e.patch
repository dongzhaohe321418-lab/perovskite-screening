+def t11_assert_run(r, sr, A, *, route, rc=0, extra_raw=()):
+    """The asserts common to every admitted route of T11: the exit code and a complete output; the route; every
+    c3b record and single point opened in block 4 only, through the real C3bAccess; the labels in E's ReadsAudit;
+    the exit audit passed with the 'manifest' class; the far-site label on the A1 rows of block 4 and on no other."""
+    b4, E, t = b4m(), ee(), r.result_text
+    P = A.plan
+    assert r.rc == rc, (r.rc, t[-1500:])
+    assert t.rstrip("\n").endswith(f"END\nE exit code: {rc}") and r.files.get("s2b/E_output.txt") == t, sorted(r.files)
+    lines = t.split("\n")
+    assert r.route["id"] == route and f"route: {route} (fr done; fr_outcome pass)" in lines, route
+    assert "BLOCK 4. Tier block (S2B §7 item 4; e_block4.py)" in lines and all(x in lines for x in (
+        "  " + s_ for s_ in b4.TITLES)) and \
+        sum(x.startswith("BLOCK 5. Hinge block: not opened.") for x in lines) == 1, \
+        (route, [s_ for s_ in b4.TITLES if "  " + s_ not in lines])
+    assert f"  S2b campaign commit (c3b): {A.commit}" in lines and \
+        f"  S2B_LAST (the last S2b campaign commit): {A.commit}" in lines and \
+        "  scripts/46-50 and E's tools: S2B_LAST -> HEAD unchanged" in lines, [x for x in lines if "S2B" in x]
+    assert f"c3b: status {P.status}; start commit {A.commit}; commit {A.commit}" in lines and \
+        f"C4b: {b4.C4B_ITEM}" in lines and any(x.endswith(f"c3b/MANIFEST.sha256 sha256 {A.sha}") for x in lines), \
+        [x for x in lines if x.startswith(("c3b", "C4b"))][:6]
+    # the open log of the private root: block 4 only for records, single points and pairs; admission for the rest
+    want4, adm = t11_expect_private(A)
+    want4 |= set(extra_raw)
+    priv = {e["rel"]: e for e in r.au.log.values() if e["base"] == "private"}
+    assert set(priv) == want4 | adm, (sorted(set(priv) ^ (want4 | adm))[:6], len(priv), len(want4 | adm))
+    assert all(priv[x]["block"] == 4 for x in want4) and all(priv[x]["block"] is None for x in adm - {
+        "c3b/state_end.json"}), [x for x in want4 if priv[x]["block"] != 4][:4]
+    acc = r._b4_access
+    assert type(acc) is eg.C3bAccess and sorted(acc.log) == sorted((w, False, 4) for w in P.records) and \
+        acc.wids == b4.ALL_WIDS and acc.labels == b4.ALL_LABELS and acc.assert_closed() is True, len(acc.log)
+    # the labels in E's ReadsAudit: every c3b single point that was parsed, in block 4; the C1 ones in block 3
+    sp = r.ctx.reads.labels["sp"]
+    read4 = {lab for lab, blk in sp.items() if blk == 4}
+    assert read4 == set(A.F) and all(blk == 3 for lab, blk in sp.items() if lab not in read4) and \
+        set(sp) - read4 <= eg.BLOCK3_SP and set(r.b4_sp) == b4.ALL_LABELS and len(r.b4_sp) == 544, \
+        (len(read4), len(A.F), len(sp))
+    assert f"  SP labels read: {len(sp)}" in lines and len(sp) == len(A.F) + len(set(sp) - read4), \
+        (len(sp), len(A.F), len(read4))
+    # the exit audit on the real path
+    cls = r.au.classify()
+    man = [rp for rp, c_ in cls.items() if c_ == ("manifest", "c3b")]
+    assert len(man) == len(priv) and r.chk.passed["INT-SHA"] >= len(man) and r.chk.passed["INT-READS"] == 1 and \
+        r.chk.passed["INT-SHA-STABLE"] == len(r.au.log) and r.chk.passed["INT-STRUCT"] >= 544, r.chk.passed
+    for i in ("INT-READS", "INT-SHA", "INT-SHA-STABLE", "INT-ROOT", "INT-IMPORT"):
+        assert any(x.startswith(f"  {i} ok (") for x in lines), i
+    # rows: printed lines, label texts, the item-4 label of the route on the A1 values of block 4 only (RF-25)
+    R = t11_rows(r)
+    assert len(R) > 600 and {"Y", "tier", "Eb_A1", "Eb_mace", "xcheck", "forces"} <= {x.kind for x in R.values()}, \
+        (len(R), sorted({x.kind for x in R.values()}))
+    a1_ids = ("B4.Eb.", "B4.Y.", "B4.site.", "B4.G.")
+    for x in R.values():
+        assert x.line is not None and x.line in t and not re.search(r"\bL_[A-Z0-9_]+\b", x.line), x.line[:200]
+        for lid in x.labels:
+            assert (b4.LABELS.get(lid) or (E.L[lid].format(clause="") if lid == "L_A1TIER" else E.L[lid])) in \
+                x.line, (x.id, lid)
+        assert ("L_FRVALID" in x.labels) == x.has_a1 and "L_ITEM4" not in x.labels, (x.id, x.labels)
+        if x.id.startswith(a1_ids):
+            assert x.has_a1, x.id
+        if x.kind in ("note", "status", "invalid", "forces", "xcheck", "class") and not x.id.startswith("B4.sens."):
+            assert not x.has_a1, x.id
+    return R, lines
