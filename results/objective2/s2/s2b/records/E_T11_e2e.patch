+def _t11_notier_fail():
+    """The far V+ cells of the A and X sublattices invalid (check 2) on seven hosts: n_d = 1 for Cl, Cs and GA."""
+    return {f"s2_{h}_V{L}{_t11_far(h, L)[0]}": [2] for h in T11_HOSTS[1:] for L in "AX"}
