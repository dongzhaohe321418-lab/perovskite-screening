+    state.update(s2b_projection=proj, c3b_complete=plan["complete"], c3b_tier=dec)
+    state.setdefault("campaigns", {})["c3b"] = "done"
+    comp = {"schema": "s2-completeness-1", "campaign": "c3b", "by_category": {"sp": {"done": len(labels)}}, "jobs": {}}
+    c46.dump_public(comp, os.path.join(cw, "completeness.json"))
+    cj["completeness"] = comp["by_category"]
+    c46.dump_public(state, os.path.join(cw, "state_end.json"))      # scripts/50 finish: the state, at the end only
+    out["tier"] = {**dec, "n_valid_quartets": res["n_valid_quartets"],
+                   "invariant_only_counts": res["invariant_only_counts"]}
+c46.dump_public(cj, os.path.join(cw, "campaign.json"))
+out["archive"] = s50.archive(stage, "c3b", plan["out"])
+with open(plan["result"], "w") as fh:
+    json.dump(out, fh)
+'''
+
+
+def _t11_far(h, L):
+    return tuple(int(x) for x in T_FAR_ROWS[L].split("|")[T11_HOSTS.index(h)].split())
+
+
+def _t11_cells(h):
+    """The 68 cells of a production host as (work id, kind, single-point label, L, site, dopant, leg): a second
+    writing of the name grammar as read in e_block4.cells_of (which cites S2B:328-329; the plan itself was not read
+    for T11), over the sites of T_FIRST and T_FAR_ROWS. It is independent of e_block4 as code, not as a source; the
+    child process compares the 544 names with the runner's production graph."""
+    out = [(f"s2_{h}_host", "host", f"s2_{h}_host", None, None, None, None)]
+    for L in "BAX":
+        out += [(f"s2_{h}_V{L}{j}", "V", f"s2_{h}_V{L}{j}", L, j, None, "vac") for j in T_FIRST[L] + _t11_far(h, L)]
+    for d in T_DOPANTS:
+        L = T_SUB[d]
+        for j in T_FIRST[L] + _t11_far(h, L):
+            out += [(f"s2_{h}_{d}{j}p0_{leg}", "D" if leg == "novac" else "DV", f"s2_{h}_{d}{j}o0_{leg}", L, j, d, leg)
+                    for leg in ("novac", "vac")]
+    return out
+
+
+def _t11_sp_F(orig):
+    """sp_F with the D+V+ single point of every pilot far (FAR4) quartet planted again, so that its E_b is within
+    +-6 meV: gate N then passes for every dopant from the single points themselves (scripts/49 gate_n_eval,
+    sigma_far <= 25 meV) and block 3's recomputation agrees with c1/gates/N.json (notes of block 4, section 6.3)."""
+    ry = Decimal(RY.numerator) / Decimal(RY.denominator)
+
+    def f(label):
+        m = re.fullmatch(r"s2_(m\d\d)_(Sr|Ca|Cl|Cs|GA)(\d+)o0_vac", label)
+        if m and m.group(1) in eg.PILOTS and int(m.group(3)) in eg.FAR4[m.group(1)][eg.SUBLATTICE[m.group(2)]]:
+            p, t, j = m.group(1), m.group(2), int(m.group(3))
+            e_meV = Decimal(hnum(label + "|t11", 12001) - 6000) / 1000
+            return str(d8(Decimal(orig(f"s2_{p}_{t}{j}o0_novac")) + Decimal(orig(f"s2_{p}_V{eg.SUBLATTICE[t]}{j}")) -
+                          Decimal(orig(f"s2_{p}_host")) + e_meV / 1000 / ry))
+        return orig(label)
+    return f
+
+
+def t11_repo(fx):
+    """The throwaway repository of T11 (cached; read-only for the case but for its notes): scenario 'pass' with a
+    C1 archive whose gates agree with what block 4 needs (gate N passed for every dopant, default poses: no second
+    kept minimum), the stub of block 4 at the fr campaign commit, and one more commit, the c3b campaign commit, that
+    implements block 4 (as 840ad22 does after the fr archive)."""
+    c = fx.__dict__.setdefault("_repos", {})
+    if "t11" not in c:
+        b4p = f"{ee().S2_REL}/s2b/e_block4.py"
+        text = block4_true_text()
+        stub = text.replace("\nBLOCK4_IMPLEMENTED = True\n", "\nBLOCK4_IMPLEMENTED = False\n")
+        g = globals()
+        with patched(g, "sp_F", _t11_sp_F(sp_F)), patched(g, "TWO_MINIMA", None):
+            sr = synth_repo(fx, "t11", {}, e_text={b4p: stub})
+        assert all(v["pass"] for v in sr.man["gate_N"]["dopants"].values()) and \
+            all(sr.man["pose"][t]["mode"] == "default" for t in ("Cs", "Cl")), "the C1 gates of T11"
+        write_text(os.path.join(sr.repo, b4p), text)
+        cc = commit(sr.repo, "c3b campaign commit (synthetic): block 4 implemented", b4p)
+        slim(sr.man)
+        c["t11"] = SR(sr.repo, sr.root, sr.man, {**sr.commits, "c3b": cc})
+    return c["t11"]
+
+
+def t11_notes(sr, A, *, stop=False):
+    """The committed notes of the archive A at HEAD of the throwaway repository: the c3b note with its one manifest
+    line, the verify record and, for a final STOP, the one stop note. Committed only when HEAD holds another text."""
+    b4 = b4m()
+    want = {b4.C3B_NOTE: f"# C3b archive note (synthetic, {A.name})\n\n2026-11-20. The private c3b archive: "
+                         f"{A.n_files} files and its manifest.\n\nc3b/MANIFEST.sha256 sha256: {A.sha}\n",
+            b4.VERIFY_C3B: f"verify c3b (synthetic, {A.name})\nfiles {A.n_files}\nverify c3b: ok\n"}
+    if stop:
+        want[b4.C3B_STOP_NOTE] = "# C3b stop note (synthetic)\n\n2026-11-20: the c3b STOP is final.\n"
+    todo = []
+    for rel, text in want.items():
+        p = os.path.join(sr.repo, rel)
+        if not os.path.exists(p) or open(p).read() != text:
+            write_text(p, text)
+            todo.append(rel)
+    if todo:
+        commit(sr.repo, f"c3b notes (synthetic, {A.name})", *todo)
+    return want
+
+
+def t11_archive(fx, sr, name, *, seed, status="done", fail=None, inv_only=(), no_record=(), sp_pending=(),
+                sp_gaveup=(), sp_absent=(), rejected=(), reached=None):
+    """A private c3b archive in the formats of the campaign (see the head of this section), cached. Planted, per
+    host: F of the host, of every V+ and D cell and, through the planted E_b (T11_EB at the first shell, a host
+    offset, noise), of every D+V+ cell, as Ry strings of 8 places; MACE energies; distinct force rows.
+    fail {wid: checks}: a cell invalid under both readings; inv_only: valid only under the invariant reading;
+    no_record: the record absent, its single point complete; sp_pending: the input only; sp_gaveup: two failed
+    attempts and .gaveup; sp_absent: no job directory; rejected (h, d, j): a rejected pair, no cell of either leg;
+    reached(h, i, kind) -> 'all' | 'record' | 'in' | None: how far a stopped campaign came with cell i of host h.
+    -> an object with priv, sha, n_files, F (Ry strings of the complete single points with a record), plan."""
+    import types
+    key = ("t11_archive", name)
+    c = fx.__dict__.setdefault("_repos", {})
+    if key in c:
+        return c[key]
+    q47, fail = fx.ex.q47, dict(fail or {})
+    rng = np.random.default_rng(seed)
+    ry = Decimal(RY.numerator) / Decimal(RY.denominator)
+    d = fx.workdir(f"t11_{name}")
+    stage, priv = os.path.join(d, "stage"), os.path.join(d, "priv")
+    cw, jobs = os.path.join(stage, "work", "c3b"), os.path.join(stage, "jobs", "s2c3b")
+    cc = sr.commits["c3b"]
+
+    def rnd(n):
+        return Decimal(int(rng.integers(-n, n + 1))) * Q8
+
+    P = types.SimpleNamespace(F={}, eb={}, mace={}, free={}, forces={}, records=set(), complete=set(), fail=fail,
+                              inv_only=set(inv_only), rejected={(h, f"{t}{j}") for h, t, j in rejected},
+                              cells={h: _t11_cells(h) for h in T11_HOSTS}, status=status)
+    rej_wids = {f"s2_{h}_{t}{j}p0_{leg}" for h, t, j in rejected for leg in ("novac", "vac")}
+    recs, n_struct = [], 0
+    for hi, h in enumerate(T11_HOSTS):
+        Fh = d8(Decimal("-9876.5") - Decimal(hi) * Decimal("0.37") + rnd(10 ** 6))
+        Fp, FV = {f"s2_{h}_host": Fh}, {}
+        for wid, kind, lab, L, j, tok, leg in P.cells[h]:
+            if kind == "V":
+                FV[(L, j)] = Fp[lab] = d8(Fh + Decimal("0.25") + rnd(2 * 10 ** 6))
+        for tok in T_DOPANTS:
+            L, off = T_SUB[tok], float(rng.normal(0, 8))
+            for j in T_FIRST[L] + _t11_far(h, L):
+                e = off + (T11_EB[tok] if j in T_FIRST[L] else 0.0) + float(rng.normal(0, 3))
+                FD = d8(Fh - Decimal("0.15") + rnd(2 * 10 ** 6))
+                Fp[f"s2_{h}_{tok}{j}o0_novac"] = FD
+                Fp[f"s2_{h}_{tok}{j}o0_vac"] = d8(FD + (FV[(L, j)] - Fh) + Decimal(repr(e)) / 1000 / ry)
+        for i, (wid, kind, lab, L, j, tok, leg) in enumerate(P.cells[h]):
+            how = "all" if reached is None else reached(h, i, kind)
+            if how is None or wid in rej_wids:
+                continue
+            free = [0, 2] if (hi + i) % 3 else [1, 2]
+            if wid not in no_record:
+                e_m = round(-1200.0 - 0.01 * i - hi + float(rng.uniform(-0.5, 0.5)), 6)
+                P.mace[lab], P.free[lab] = e_m, free
+                if kind == "host":
+                    stages = [{"fmax_target": t_, "steps": 40 + s_, "converged": True, "fmax": 0.9 * t_,
+                               "E_mace_eV": round(e_m + 0.3 / (s_ + 1), 6)} for s_, t_ in enumerate((0.02, 0.01, 0.005))]
+                    relax = {"optimizer": "ASE FIRE, default parameters, restarted per stage (scripts/29 "
+                                          "relax_staged)", "fmax_eVA": 0.005, "fmax_stages_eVA": [0.02, 0.01, 0.005],
+                             "steps_cap": 10000, "steps_cap_is": "per stage", "steps": 123, "stage_flag": True,
+                             "fmax_final_free_eVA": 0.0045, "held_max_dr_A": 0.0, "wall_s": 1.0, "stages": stages,
+                             "E_mace_eV": e_m, "converged": True}
+                    c1 = {"passed": wid not in fail, "steps": 123, "fmax_final_free_eVA": 0.0045, "strict": True,
+                          "stage_flag": True, "stages_converged": [True, True, True]}
+                    val = {"checks": {"1": c1, "2": None, "3": None, "4": {"passed": True}, "5": None},
+                           "valid": wid not in fail, "failed": list(fail.get(wid, []))}
+                else:
+                    relax = {"optimizer": "ASE FIRE, default parameters", "fmax_eVA": 0.01, "steps_cap": 2000,
+                             "steps": 50 + i, "converged": True, "fmax_final_free_eVA": 0.009, "held_max_dr_A": 0.0,
+                             "n_free": len(free), "n_fixed": 3 - len(free), "max_dr_free_A": 0.2, "wall_s": 1.0,
+                             "E_mace_eV": e_m}
+                    fl = list(fail.get(wid, []))
+                    fw = sorted(set(fl) | ({5} if wid in P.inv_only else set()))
+                    appl = {"V": (1, 2, 4, 5), "D": (1, 3, 4, 5), "DV": (1, 2, 3, 4, 5)}[kind]
+                    chk = {str(k): ({"passed": k not in fl} if k in appl else None) for k in range(1, 6)}
+                    chk["5"].update(passed_as_written=5 not in fw, parent=f"s2_{h}_host" if kind != "DV" else
+                                    f"s2_{h}_V{L}{j}", centre="v" if kind == "V" else "site j")
+                    val = {"checks": chk, "valid": not fl, "failed": fl, "check5_reading": "invariant",
+                           "valid_as_written": not fw, "failed_as_written": fw, "invariant_only": not fl and bool(fw)}
+                files, shas = {}, {}
+                for k in ("start", "relaxed"):
+                    rel = f"cells/{wid}/{k}.extxyz"
+                    txt = (f'3\nLattice="21.0 0.0 0.0 0.0 21.0 0.0 0.0 0.0 21.0" Properties=species:S:1:pos:R:3 '
+                           f'pbc="T T T"\nPb 0.0 0.0 0.0\nI 3.1 0.0 0.0\nCs {hnum(wid + k, 9000) / 1000.0:.3f} 5.0 5.0\n')
+                    write_text(os.path.join(cw, *rel.split("/")), txt)
+                    files[k], shas[k] = rel, hashlib.sha256(txt.encode()).hexdigest()
+                    n_struct += 1
+                recs.append(dict(
+                    work_id=wid, labels=[lab], campaign="c3b", member=h, role="production", cell_kind=kind, leg=leg,
+                    site=j, site_cell=j, sublattice=L, site_roles=[] if kind == "host" else
+                    ["first" if j in T_FIRST[L] else "far"], token=tok, start=None if tok is None else "p0",
+                    pose_id=None if tok is None else "default", is_default_pose=None if tok is None else True,
+                    k_min=None if tok is None else 0, region_id=None if kind == "host" else
+                    hashlib.sha256(f"{h}{L}{j}".encode()).hexdigest()[:16], free=free, n_free=len(free),
+                    n_fixed=3 - len(free), parent={"work_id": None if kind == "host" else f"s2_{h}_host",
+                                                   "map": None if kind == "host" else "to_vac" if kind == "V" else
+                                                   "old_to_new"},
+                    pair=None if tok is None else f"pairs/{h}_{tok}{j}p0.json",
+                    builder={"BUILDER_VERSION": "synthetic", "GEOM_SHA": "0" * 64, "partners": None if tok is None
+                             else "relaxed"}, model={"mock": "supplied"}, relax=relax, validity=val, files=files,
+                    sha256=shas, geometry_sha256=dict(shas), attempts=[],
+                    code={"script_sha256": {"46": "0" * 64}, "git": {"head": cc, "clean": True}}))
+                P.records.add(wid)
+            if how == "record" or lab in sp_absent:
+                continue
+            jd = os.path.join(jobs, lab)
+            write_text(os.path.join(jd, f"{lab}.in"), f"&control\n  calculation = 'scf'\n/\n! {lab}\n")
+            with open(os.path.join(jd, f"{lab}.meta.json"), "w") as fh:
+                fh.write(json.dumps({"schema": "s2-qejob-1", "label": lab, "kind": "sp", "campaign": "c3b",
+                                     "cell": {"work_id": wid}, "ranks_expected": 64, "queue": None, "result": None},
+                                    indent=1))
+            if how == "in" or lab in sp_pending:
+                continue
+            frows = sp_forces(lab)
+            txt, _ = pw_text(q47, input_name=lab, k0=0, n_config=1, end="done", F=[str(Fp[lab])],
+                             pos=positions_fn(lab, 3), frc=lambda k, fr=frows: np.array([[float(v) for v in r]
+                                                                                        for r in fr]),
+                             symbols=SYM_SP, calculation="scf")
+            if lab in sp_gaveup:                         # two attempts without JOB DONE, then .gaveup (qe_queue.sh)
+                cut = txt[:txt.index("JOB DONE")].rsplit("\n", 1)[0] + "\n"
+                for n in (1, 2):
+                    write_text(os.path.join(jd, f"{lab}.out.try{n}"), cut)
+                write_text(os.path.join(jd, f"{lab}.gaveup"), f"{T11_TS} gave up\n")
+                continue
+            write_text(os.path.join(jd, f"{lab}.out"), txt)
+            P.complete.add(lab)
+            P.forces[lab] = frows
+            if wid in P.records:
+                P.F[lab] = str(Fp[lab])
+        for L in "BAX":                                  # scripts/46 job_region, job_pair, job_distinct (names, status)
+            for j in T_FIRST[L] + _t11_far(h, L):
+                if f"s2_{h}_V{L}{j}" in P.records:
+                    with open(os.path.join(cw, "regions", f"{h}_{L}{j}.json"), "w") if os.makedirs(
+                            os.path.join(cw, "regions"), exist_ok=True) is None else None as fh:
+                        fh.write(json.dumps({"schema": "s2-region-1", "member": h, "site": j, "sublattice": L,
+                                             "free": [0, 1, 2], "n_free": 3, "region_id": hashlib.sha256(
+                                                 f"{h}{L}{j}".encode()).hexdigest()[:16]}, indent=1))
+        for tok in T_DOPANTS:
+            for j in T_FIRST[T_SUB[tok]] + _t11_far(h, T_SUB[tok]):
