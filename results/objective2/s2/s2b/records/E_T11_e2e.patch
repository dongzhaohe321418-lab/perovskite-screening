+def t11_res_of_rows(R):
+    """evaluate_tier's result as E printed it, rebuilt from the values of the block-4 rows (for assert_tier): what
+    is compared with the independent tier is what the output holds, not an object of e_block4."""
+    nd = R["B4.nd"].values
+    res = {"n_d": dict(nd["n_d"]), "computable": nd["computable"], "per_dopant": {}, "hv": {}, "ranking": {}}
+    for d in T_DOPANTS:
+        t = R[f"B4.tier.{d}"].values
+        a1 = {**t, "available": "Ybar_meV" in t}
+        if f"B4.class.{d}" in R:
+            a1["class_rule_v"] = R[f"B4.class.{d}"].values.get("rule_v")
+        ys = {h: R[f"B4.Y.{h}.{d}"].values for h in T11_HOSTS}
+        site = {x.id.rsplit(".", 1)[1]: x.values for i, x in R.items() if i.startswith(f"B4.site.{d}.")}
+        g, ctl = R[f"B4.G.{d}"].values, (R.get(f"B4.controls.{d}").values if f"B4.controls.{d}" in R else {})
+        res["hv"][d] = {h: {"Delta_h_meV": v["Delta_h_meV"]} for h, v in ys.items()}
+        res["per_dopant"][d] = {
+            "a1": a1, "Y": {h: v["Y_h_meV"] for h, v in ys.items() if v["valid"]},
+            "het": {"Ebar_meV": {j: v["Ebar_meV"] for j, v in site.items() if v["Ebar_meV"] is not None},
+                    "G_meV": g["G_meV"], "flag": g.get("flag", False)},
+            "C2": {"pass": ctl.get("C2")}, "C3": ctl.get("C3"), "C4": {"pass": ctl.get("C4")},
+            "class": R[f"B4.class.{d}"].values["class"] if f"B4.class.{d}" in R else None,
+            "required_hosts": R[f"B4.required.{d}"].values["required"]}
+    for i, x in R.items():
+        if i.startswith("B4.rank.") and i != "B4.rank":
+            res["ranking"][i[len("B4.rank."):]] = {"n": x.values["n"], "mean_meV": x.values["mean_meV"],
+                                                   "interval_meV": x.values["interval_meV"]}
+    if not res["ranking"]:
+        res["ranking"] = None
+    return res
