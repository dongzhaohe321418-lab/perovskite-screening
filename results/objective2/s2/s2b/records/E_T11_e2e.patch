+def _t11_early_read(orig, wid):
+    """Run.block3 followed by an open of one c3b record while the audit is still in block 3."""
+    def f(self, o, quiet=False):
+        out = orig(self, o, quiet=quiet)
+        with open(self.L.record("c3b", wid), "rb") as fh:
+            fh.read(1)
+        return out
+    return f
