+def t11_ind_table(sr, A):
+    """The table of the independent tier (ind_tier), from the planted values of the archive alone: F (eV) of every
+    complete single point with a record, validity as planted, the rejected pairs, the sites of the second
+    transcription and the C1 gates of the throwaway repository. Nothing of E's table is used."""
+    P, hosts = A.plan, {}
+    for h in T11_HOSTS:
+        H = {"host_valid": False, "F": {}, "cell_valid": {}, "failed_checks": {}, "pair_rejected": {}, "E_mace": {}}
+        for wid, kind, lab, L, j, tok, leg in P.cells[h]:
+            if wid in P.records:
+                H["cell_valid"][lab], H["failed_checks"][lab] = wid not in P.fail, list(P.fail.get(wid, []))
+                H["E_mace"][lab] = P.mace[lab]
+                if kind == "host":
+                    H["host_valid"] = wid not in P.fail
+            H["F"][lab] = float(P.F[lab]) * float(RY) if lab in P.F else None
+        for hh, tj in sorted(P.rejected):
+            if hh == h:
+                H["pair_rejected"][tj] = ["p0"]
+        hosts[h] = H
+    gates = {"N": {d: {"pass": v["pass"]} for d, v in sr.man["gate_N"]["dopants"].items()},
+             "pose": {t: {"mode": v["mode"], "a_pose_meV": v["a_pose_meV"]} for t, v in sr.man["pose"].items()},
+             "G1": {"Cl": {"pass": True}, "Ca": {"pass": False}}}
+    return {"production": list(T11_HOSTS), "n": 8, "gates": gates, "hosts": hosts,
+            "sites": {h: {L: {"first": list(T_FIRST[L]), "far": list(_t11_far(h, L))} for L in "BAX"}
+                      for h in T11_HOSTS}}
+
+
+def t11_rows(r):
+    R = {}
+    for x in r.rows:
+        if x.block == 4:
+            assert x.id not in R, x.id
+            R[x.id] = x
+    return R
