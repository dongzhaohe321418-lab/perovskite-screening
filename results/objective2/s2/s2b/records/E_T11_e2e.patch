+
+
+out = {"sites": tab, "production": state["stage0"]["production_n8"], "c4b_origin": g49.C4B_ORIGIN, "tier": None}
+for i, point in enumerate(("fr", "c3b")):
+    proj = {"points": ["fr", "c3b"][:i + 1], "cuts": [], "c4b_run": g49.C4B_PLANNED, "c4b_origin": g49.C4B_ORIGIN}
